# ============================================================
# CYBERNOVA SOC Operations Lab
# Git Ignore Policy
# ============================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# Build artifacts
build/
dist/
*.egg-info/

# IDE configuration
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Local databases
*.db
*.sqlite
*.sqlite3

# Local logs
*.log
